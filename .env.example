# ------------------------------------------------------------------
#  MySQL Web Client settings
#  Edit the values below, save the file, then run start.bat.
# ------------------------------------------------------------------

# The MySQL server where the app keeps its own data (saved connections
# and query history). "host.docker.internal" means "this PC".
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=sql_client_app
DB_USERNAME=root
DB_PASSWORD=change-me

# Port for the web page: open http://localhost:8080 in your browser.
APP_PORT=8080

# Optional. Leave empty and a key is generated automatically on first start.
ENCRYPTION_KEY=

# Set to true only during a proctored lab exam.
LAB_EXAM_MODE=false
